\ProvidesPackage{beamerthemeecl24}[2026/01/22]

\mode<presentation>

%% Chargement des extensions
\RequirePackage{tikz}
\RequirePackage{ifthen}
\RequirePackage{etoolbox}

%% Pour insérer la licence creative commons BY-NC-ND
\newboolean{@ccbyncnd}
\setboolean{@ccbyncnd}{false}
%% Image de fond de la page de garde avec photo
\newboolean{@p1photo}
\setboolean{@p1photo}{false}
%% Dernière page dans le thème défini par l'école centrale de Lyon
\newboolean{@finecl}
\setboolean{@finecl}{false}
%% Le thème n'est disponible qu'au format 4:3 pour l'instant

%% Déclaration des options
\DeclareOption{ccbyncnd}{
  \setboolean{@ccbyncnd}{true}
}
\DeclareOption{p1photo}{
  \setboolean{@p1photo}{true}
}
\DeclareOption{finecl}{
  \setboolean{@finecl}{true}
}
\ProcessOptions\relax

%% Images de fond
\setbeamertemplate{background}{%
  \begin{tikzpicture}[overlay,remember picture]%
    \ifnumequal{\c@framenumber}{1}{%
      % Page de garde
      \ifthenelse{\boolean{@p1photo}}{%
        % Si on veut la page de garde avec photo
        \node[opacity=1, at=(current page.center)] {%
          \includegraphics[width=\paperwidth,height=\paperheight]{ECL-p1-43-photo.pdf}};%
      }{% Sinon
        \node[opacity=1, at=(current page.center)] {%
          \includegraphics[width=\paperwidth,height=\paperheight]{ECL-p1-43.pdf}};%
    }}{%
      \ifnumequal{\c@framenumber}{\inserttotalframenumber}{%
        % Si on veut que la dernière page soit aux couleurs de l'école
        \node[opacity=1, at=(current page.center)] {
          \includegraphics[width=\paperwidth,height=\paperheight]{ECL-fin-43.pdf}};
      }{% Autres pages
      \node at (10.2,-0.9) [opacity=1, anchor=west]{%
        \includegraphics[width=2cm]{ECL.png}};%
    }}%
  \end{tikzpicture}
}

% Page de garde
\setbeamertemplate{title page}{%
  \vskip3cm%
  \begin{beamercolorbox}{title page}%
    \textbf{\LARGE{\inserttitle}}\\[-1ex]%
    \rule{3cm}{1pt}%
  \end{beamercolorbox}%

  \begin{beamercolorbox}{author}%
    \vskip0.5ex%
    \textbf{\large{\insertsubtitle}}%

    \vskip2em%
    \insertauthor%
  
    \vskip1em%
    \insertdate%
  \end{beamercolorbox}%
}%

% Titre(s) d'une page
\defbeamertemplate*{frametitle}{ecl24}{%
  \begin{beamercolorbox}[wd=\paperwidth, left, leftskip=0.2cm]{frametitle}%
    \begin{minipage}[c][1.2cm][c]{9.6cm} %12.8cm x 9.6cm
      \ifx\insertframesubtitle\@empty{%
        {\large\hspace{-0ex}\insertframetitle\par\vspace{-1.6ex}\rule{3cm}{1pt}\par}%
      }\else{%
        {\large\hspace{-0ex}\insertframetitle\par\vspace{-1.6ex}\rule{3cm}{1pt}\par}%
        {\normalsize\insertframesubtitle\par}%
      }\fi%
    \end{minipage}%
  \end{beamercolorbox}%
}%


% Pied de page
\setbeamertemplate{footline}{%
  \ifnumequal{\c@framenumber}{1}{}{%
    \ifnumequal{\c@framenumber}{\inserttotalframenumber}{}{%
      \leavevmode%
      \hbox{%
        \begin{beamercolorbox}[wd=.3\paperwidth,left]{section in head/foot}%
          \hspace*{2ex}\insertshorttitle%
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.4\paperwidth,center]{section in head/foot}%
          \ifthenelse{\boolean{@ccbyncnd}}{%
            % Licence creative commons BY-NC-ND
            \insertshortauthor~\includegraphics[height=4ex]{by-nc-nd.png}%
          }{%
            \insertshortauthor%
          }%
        \end{beamercolorbox}%
        \begin{beamercolorbox}[wd=.3\paperwidth,right]{section in head/foot}%
          \insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
      \end{beamercolorbox}}%
}}}%

%% Couleurs
\definecolor{RougeECL}{RGB}{176,16,43}

\setbeamercolor{structure}{fg=RougeECL}
\setbeamercolor{alerted text}{fg=RougeECL}
\setbeamercolor{example text}{fg=green!50!black}
\setbeamercolor{normal text}{fg=black,bg=white}

\setbeamercolor*{title page}{fg=RougeECL}
\setbeamercolor*{author}{fg=black}

%% Icône de début d'item
\setbeamertemplate{itemize item}[ball]
\setbeamertemplate{itemize subitem}[style]
\setbeamertemplate{itemize subsubitem}[style]
\setbeamertemplate{enumerate item}[ball]
\setbeamertemplate{enumerate subitem}[ball]
\setbeamertemplate{enumerate subsubitem}[ball]
\setbeamertemplate{section in toc}[ball]
\setbeamertemplate{subsection in toc}[ball]

%% Blocs
\setbeamertemplate{blocks}[rounded][shadow=true]
\setbeamercolor{block title}{fg=RougeECL, bg=RougeECL!15!white}
\setbeamercolor{block body}{fg=black, bg=white}

\setbeamercolor{block title alerted}{fg=white, bg=RougeECL}
\setbeamercolor{block body alerted}{fg=black, bg=RougeECL!15!white}

\setbeamercolor{block title example}{fg=green!30!black, bg=green!50!white}
\setbeamercolor{block body example}{fg=black, bg=green!5!white}

\mode<all>

\endinput
